# Copy to .env and fill with your Supabase project values
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# Optional server-side overrides (if different from client)
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=

# Required only by privileged server-only operations; never place this key in frontend VITE_* variables.
# SUPABASE_SERVICE_ROLE_KEY=
