# Copy to .env and fill in. Never commit .env (it is git-ignored).
#
# Local development: run `supabase start`, then copy API_URL and
# PUBLISHABLE_KEY from `supabase status` into the four values below.
# Hosted: use Supabase Dashboard -> Project Settings -> API Keys.

# Browser (public by design; access is enforced by row-level security)
VITE_SUPABASE_URL=http://127.0.0.1:54421
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_from_supabase_status
VITE_SUPABASE_PROJECT_ID=local

# Server functions (same values as above)
SUPABASE_URL=http://127.0.0.1:54421
SUPABASE_PUBLISHABLE_KEY=sb_publishable_from_supabase_status

# Server only, optional: needed only for in-app account deletion.
# Never prefix with VITE_ and never commit a real value.
# SUPABASE_SERVICE_ROLE_KEY=

# Optional: Node server port (default 3000)
# PORT=3000
